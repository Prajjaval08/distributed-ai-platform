# PostgreSQL
POSTGRES_PASSWORD=changeme_local_dev_only
# JWT
JWT_SECRET=changeme_use_a_long_random_string_at_least_256_bits
JWT_EXPIRATION_MS=900000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_JOB_CACHE_TTL_SECONDS=60

# Rate Limiting
RATE_LIMIT_JOBS_PER_HOUR=100
RATE_LIMIT_AUTH_PER_HOUR=10


# Priority topics
KAFKA_TOPIC_AI_JOBS_HIGH=ai-jobs-high
KAFKA_TOPIC_AI_JOBS_LOW=ai-jobs-low