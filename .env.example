# PostgreSQL
POSTGRES_PASSWORD=changeme_local_dev_only
# JWT
JWT_SECRET=changeme_use_a_long_random_string_at_least_256_bits
JWT_EXPIRATION_MS=900000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_JOB_CACHE_TTL_SECONDS=60

# Rate Limiting
RATE_LIMIT_JOBS_PER_HOUR=100
RATE_LIMIT_AUTH_PER_HOUR=10


# Priority topics
KAFKA_TOPIC_AI_JOBS_HIGH=ai-jobs-high
KAFKA_TOPIC_AI_JOBS_LOW=ai-jobs-low


# Resilience
AI_PROVIDER_TIMEOUT_SECONDS=10
OBJECT_STORAGE_TIMEOUT_SECONDS=5
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
CIRCUIT_BREAKER_WAIT_DURATION_SECONDS=10
CIRCUIT_BREAKER_MIN_CALLS=5

# Read Replica
REPLICA_DB_URL=jdbc:postgresql://localhost:5433/ai_platform


# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME_API=api-service
OTEL_SERVICE_NAME_WORKER=worker-service


# Docker production-like environment (Phase 22)
# Inside Compose, service hostnames (postgres, redis, kafka, minio, jaeger)
# and the OTel endpoint (http://jaeger:4317) are set in docker-compose.yml,
# so the localhost values above only apply when running services on the host.
OBJECT_STORAGE_BUCKET=ai-platform-artifacts
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
AI_PROVIDER_TYPE=mock
KAFKA_TOPIC_AI_JOBS=ai-jobs
KAFKA_TOPIC_AI_JOBS_DLQ=ai-jobs-dlq
